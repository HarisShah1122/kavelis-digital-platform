# Kavelis — public frontend configuration
# Copy this file to `.env` (or set these in your hosting provider) and fill in values.
# Never commit real secrets — this frontend only accepts public settings.

# Production origin used for canonical URLs, Open Graph tags, and sitemap links.
VITE_SITE_URL=https://kavelis.llc

# Public business email displayed on the contact page and footer.
# Leave empty until a confirmed address exists — nothing will be rendered.
VITE_CONTACT_EMAIL=

# HTTP endpoint that accepts POST JSON project inquiries (e.g. Formspree form endpoint).
# The contact form sends: { name, email, company, service, budget, timeline, message, reference?, submittedAt }
# When unset, the form honestly reports that delivery is not connected.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/xoejrogp
